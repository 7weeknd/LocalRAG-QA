# 复制为 .env 并按需填写（本项目通过环境变量读取，也可直接 export / set）

# 知识库目录（默认 data/docs；填绝对或相对路径均可）
# RAG_DATA_DIR=data/docs

# 切片与检索参数
# RAG_CHUNK_SIZE=300
# RAG_OVERLAP=50
# RAG_TOP_K=5
# RAG_FINAL_K=3
# RAG_MIN_SCORE=0.05
# RAG_MIN_COVERAGE=0.35

# 大模型配置（OpenAI 兼容接口，任填一个即可接入）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
# ============ LocalRAG-QA 配置模板：复制本文件为 .env 后填写 ============

# --- MySQL 本地连接 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=rag_qa

# --- JWT 登录令牌 ---
# 生成随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=10080

# --- 大模型（默认本地 Ollama；换成 DeepSeek 等云端服务只改这三项）---
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:0.8b

# --- 向量模型（LangChain 版语义检索用；先执行 ollama pull nomic-embed-text）---
EMBEDDING_MODEL=nomic-embed-text

# --- 切块与检索参数（默认值已按实测校准，一般不用改）---
RAG_CHUNK_SIZE=300
RAG_OVERLAP=50
RAG_TOP_K=5
RAG_FINAL_K=3

# --- 防幻觉阈值：覆盖率为主判据，相似度阈值只做兜底（详见 README「防幻觉」一节）---
RAG_MIN_SCORE=0.75
RAG_MIN_COVERAGE=0.35
